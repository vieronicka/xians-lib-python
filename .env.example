# Xians SDK – copy to .env and fill in your values
# Do not commit .env (it should contain secrets).

# Xians Server (required when using an existing server)
XIANS_SERVER_URL=https://api.xians.ai
XIANS_API_KEY=

# Temporal (optional – omit to use local defaults: localhost:7233, default)
# When using an existing Xians Server, leave unset to fetch from server.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default

# Tenant (optional – for Manager UI; set e.g. default if server requires X-Tenant-Id on outbound chat)
# XIANS_TENANT_ID=default
